# PostgreSQL connection string used by Prisma. Use a private, TLS-enabled database URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moz_deli?sslmode=require"

# Canonical public HTTPS origin in production; used by checkout, metadata and crawler files.
APP_BASE_URL="https://your-domain.example"

# Server-side Stripe secret key. Never expose it with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=""
# Signing secret for the Stripe webhook endpoint; use the matching test/live endpoint secret.
STRIPE_WEBHOOK_SECRET=""

# PayFast credentials for the existing database-backed order flow.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX_MODE="true"
# The trusted reverse proxy must overwrite this header with the actual client IP.
PAYFAST_SOURCE_IP_HEADER="x-forwarded-for"

# Auth.js and the single administrator account. ADMIN_EMAIL accepts an email or username.
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Optional payment-confirmation email delivery.
RESEND_API_KEY=""
EMAIL_FROM=""
ORDER_NOTIFICATION_EMAIL=""
